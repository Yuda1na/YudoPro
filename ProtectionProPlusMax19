            if CoreGui then
                for _, gui in ipairs(CoreGui:GetChildren()) do
                    if gui:IsA("ScreenGui") and gui.DisplayOrder >= 9999 and gui.Name ~= "Rayfield" then
                        gui:Destroy()
                    end
                end
            end
        end
    )

    pushAlert("Recovery Complete", "Mouse, camera, and controls restored to default.", 3)
