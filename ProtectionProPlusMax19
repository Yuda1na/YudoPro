local function isWebhook(url)
    if type(url) ~= "string" then
        return false
    end
    local lower = string.lower(url)
    for _, pattern in ipairs(WEBHOOK_PATTERNS) do
        if string.find(lower, pattern, 1, true) then
            return true
        end
    end
    return false
end

local function isIPGrabber(url)
    if type(url) ~= "string" then
        return false
    end
    local lower = string.lower(url)
    for _, domain in ipairs(IP_LOGGER_DOMAINS) do
        if string.find(lower, domain, 1, true) then
            return true, domain
        end
    end
    return false, nil
end

