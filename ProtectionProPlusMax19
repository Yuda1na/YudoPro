local function processHttpTraffic(originalFunc, options, ...)
    if type(options) ~= "table" or not options.Url then
        return originalFunc(options, ...)
    end

    local url = tostring(options.Url)

    if Config.logOutboundRequests then
        print("[Yudo HTTP] " .. tostring(options.Method or "GET") .. " " .. url)
    end

    if Config.webhookNeutralizer and isWebhook(url) then
        Stats.webhooksBlocked = Stats.webhooksBlocked + 1
        recordThreat("Webhook", "Blocked Discord webhook call: " .. url:sub(1, 50) .. "...")
        pushAlert("Webhook Neutralized", "Blocked unauthorized Discord exfiltration payload.", 3)
        updateStatsUI()
        return {
            StatusCode = 200, StatusMessage = "OK",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(
                {id = "blocked", type = 1, channel_id = "0", content = "blocked"}
            )
        }
    end

    local isGrab, grabDomain = isIPGrabber(url)
    if Config.ipMasking and isGrab then
        Stats.ipGrabbersBlocked = Stats.ipGrabbersBlocked + 1
        recordThreat("IP-Grabber", "Spoofed grabber lookup from: " .. tostring(grabDomain))
        pushAlert("IP Grabber Spoofed", "Fed synthetic proxy data to: " .. tostring(grabDomain), 3)
        updateStatsUI()

        if Config.spoofLoggerResponse then
            return {
                StatusCode = 200, StatusMessage = "OK",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(
                    {
                        ip = Config.fakeIP, query = Config.fakeIP,
                        country = Config.fakeCountry or "Switzerland",
                        country_code = Config.fakeCountryCode or "CH",
                        city = Config.fakeCity or "Zurich", region = Config.fakeRegion or "ZH",
                        isp = Config.fakeISP or "SecureProxy Network", status = "success"
                    }
                )
            }
        else
            return {
                StatusCode = 403, StatusMessage = "Forbidden", Headers = {},
                Body = "Access Denied by YudoProtection"
            }
        end
    end

    local isRbx, rbxDomain = isRobloxWeb(url)
    if Config.sessionApiShield and isRbx then
        Stats.robloxApisBlocked = Stats.robloxApisBlocked + 1
        recordThreat("Roblox-API", "Blocked unauthorized web query to: " .. tostring(rbxDomain))
        pushAlert(
            "API Blocked",
            "Blocked script accessing internal Roblox web endpoint: " .. tostring(rbxDomain), 3
        )
        updateStatsUI()
        return {
            StatusCode = 403, StatusMessage = "Forbidden", Headers = {},
            Body = HttpService:JSONEncode(
                {errors = {{code = 403, message = "Access Denied by YudoProtection"}}}
            )
        }
    end

    if isDiscordRPC(url) then
        recordThreat("Discord-RPC", "Blocked local Discord RPC socket attempt: " .. url)
        return {StatusCode = 403, StatusMessage = "Forbidden", Headers = {}, Body = ""}
    end

    return originalFunc(options, ...)
end

local function setupNetworkInterceptors()
    local targetList = {}

    local function addTarget(fn, name)
        if type(fn) == "function" then
            for _, item in ipairs(targetList) do
                if item.fn == fn then
                    return
                end
            end
            table.insert(targetList, {fn = fn, name = name})
        end
    end

    if type(request) == "function" then
        addTarget(request, "request")
    end
    if type(http_request) == "function" then
        addTarget(http_request, "http_request")
    end

    if type(syn) == "table" and type(syn.request) == "function" then
        addTarget(syn.request, "syn.request")
    end
    if type(fluxus) == "table" and type(fluxus.request) == "function" then
        addTarget(fluxus.request, "fluxus.request")
    end
    if type(http) == "table" and type(http.request) == "function" then
        addTarget(http.request, "http.request")
    end
    if type(getgenv) == "function" then
        local ok, genv = pcall(getgenv)
        if ok and type(genv) == "table" and type(genv.request) == "function" then
            addTarget(genv.request, "getgenv().request")
        end
    end

    for _, target in ipairs(targetList) do
        pcall(
            function()
                local original = target.fn
                local oldTrampoline
                local hook = registerProtectedClosure(
                    function(options, ...)
                        return processHttpTraffic(oldTrampoline or original, options, ...)
                    end
                )
                if type(hookfunction) == "function" then
                    oldTrampoline = hookfunction(original, hook)
                    hookedFunctions[target.name] = {
                        original = oldTrampoline or original, hooked = hook
                    }
                end
            end
        )
    end
end
setupNetworkInterceptors()

