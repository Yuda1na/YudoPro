local function generateRandomHex(length)
    local hexChars = "0123456789ABCDEF"
    local result = {}
    for i = 1, length do
        local r = math.random(1, 16)
        result[i] = string.sub(hexChars, r, r)
    end
    return table.concat(result)
end

local function generateRandomHWID()
    return string.format(
        "%s-%s-%s-%s-%s", generateRandomHex(8), generateRandomHex(4), "4" .. generateRandomHex(3),
        generateRandomHex(4), generateRandomHex(12)
    )
end

local function generateRandomIdentity()
    math.randomseed(
        os.time() + math.floor(tick() % 100000) + (LocalPlayer and LocalPlayer.UserId or 12345)
    )
    local loc = poolLocations[math.random(1, #poolLocations)]
    local ip = loc.ipPrefix .. tostring(math.random(2, 254)) .. "." .. tostring(math.random(2, 254))
    local hwid = generateRandomHWID()
    return ip, loc.city .. ", " .. loc.country, hwid, loc
end

