local function setupMetamethodGuards()
    local ok, rawMeta = pcall(getrawmetatable, game)
    if not ok or not rawMeta then
        return
    end

    local oldNamecall = rawMeta.__namecall
    originalNamecall = oldNamecall

    if type(setreadonly) == "function" then
        pcall(setreadonly, rawMeta, false)
    end

    local newNamecall = newcclosure and newcclosure(
        function(self, ...)
            local method = getnamecallmethod()

            if Config.robuxVault and self == MarketplaceService then
                if method == "PromptPurchase" or method == "PromptProductPurchase" or method == "PromptGamePassPurchase" or method == "PromptSubscriptionPurchase" or method == "PromptBundlePurchase" then
                    Stats.robuxPromptsBlocked = Stats.robuxPromptsBlocked + 1
                    local args = {...}
                    local assetId = tostring(args[2] or "Unknown")
                    recordThreat(
                        "Robux-Vault",
                        "Blocked purchase prompt! Call: " .. method .. " | Asset: " .. assetId
                    )
                    pushAlert("Robux Vault", "Blocked prompt purchase for AssetId: " .. assetId, 3)
                    updateStatsUI()
                    return nil
                end
            end

            if Config.serverHopBlocker and self == TeleportService then
                if method == "Teleport" or method == "TeleportToPlaceInstance" or method == "TeleportToSpawnPage" or method == "TeleportCancel" then
                    Stats.serverHopsBlocked = Stats.serverHopsBlocked + 1
                    recordThreat("Server-Hop", "Blocked unauthorized server teleport attempt")
                    pushAlert(
                        "Teleport Blocked", "Blocked untrusted script from hopping servers.", 3
                    )
                    updateStatsUI()
                    return nil
                end
            end

            if Config.httpServiceFilter and self == HttpService then
                if method == "PostAsync" or method == "RequestAsync" or method == "GetAsync" then
                    local args = {...}
                    local targetUrl = tostring(args[1] or "")
                    if isWebhook(targetUrl) or isIPGrabber(targetUrl) or isRobloxWeb(targetUrl) then
                        recordThreat(
                            "HttpService", "Blocked HttpService." .. method .. " to: " .. targetUrl
                        )
                        return ""
                    end
                end
            end

            if Config.silentMouth then
                local selfName = tostring(self)
                if selfName == "SayMessageRequest" and method == "FireServer" then
                    Stats.forcedChatsBlocked = Stats.forcedChatsBlocked + 1
                    recordThreat(
                        "Silent-Mouth", "Blocked forced SayMessageRequest chat transmission"
                    )
                    updateStatsUI()
                    return nil
                end
            end

            return oldNamecall(self, ...)
        end
    ) or function(self, ...)
        local method = getnamecallmethod()
        if Config.robuxVault and self == MarketplaceService then
            if method == "PromptPurchase" or method == "PromptProductPurchase" or method == "PromptGamePassPurchase" then
                Stats.robuxPromptsBlocked = Stats.robuxPromptsBlocked + 1
                return nil
            end
        end
        return oldNamecall(self, ...)
    end

    rawMeta.__namecall = newNamecall

    if type(setreadonly) == "function" then
        pcall(setreadonly, rawMeta, true)
    end
end
setupMetamethodGuards()

local function setupFileSystemProtection()
    local DANGEROUS_EXTS = {
        ".exe", ".bat", ".cmd", ".vbs", ".ps1", ".scr", ".pif", ".dll", ".so", ".sh"
    }

    local function checkPathSafe(path, content)
        if type(path) ~= "string" then
            return false, "Invalid path type"
        end
        local lower = string.lower(path)

        if string.find(lower, "..", 1, true) or string.find(lower, "c:", 1, true) or string.find(
            lower, "/etc/", 1, true
        ) then
            return false, "Directory traversal attempt blocked"
        end

        for _, ext in ipairs(DANGEROUS_EXTS) do
            if string.sub(lower, -#ext) == ext then
                return false, "Executable extension blocked: " .. ext
            end
        end

        local maxBytes = Config.maxWriteMB * 1024 * 1024
        if content and type(content) == "string" and #content > maxBytes then
            return
                false,
                "File write quota exceeded (" .. math.floor(#content / 1024) .. " KB > " .. math.floor(
                    maxBytes / 1024
                ) .. " KB)"
        end

        return true, nil
    end

    if type(writefile) == "function" and type(hookfunction) == "function" then
        pcall(
            function()
                local origWrite = writefile
                local origCloned = (type(clonefunction) == "function" and clonefunction(origWrite))
                local oldTrampoline
                local writeHook = registerProtectedClosure(
                    function(path, content, ...)
                        if Config.fileSandbox then
                            local ok, reason = checkPathSafe(path, content)
                            if not ok then
                                Stats.suspiciousFilesBlocked = Stats.suspiciousFilesBlocked + 1
                                recordThreat(
                                    "File-Sandbox",
                                    "Blocked writefile: " .. tostring(path) .. " (" .. tostring(
                                        reason
                                    ) .. ")"
                                )
                                pushAlert("File Blocked", tostring(reason), 3)
                                updateStatsUI()
                                return false
                            end
                        end
                        if oldTrampoline then
                            return oldTrampoline(path, content, ...)
                        end
                        if origCloned and origCloned ~= origWrite then
                            return origCloned(path, content, ...)
                        end
                        return origWrite(path, content, ...)
                    end
                )
                oldTrampoline = hookfunction(writefile, writeHook)
                hookedFunctions["writefile"] = {
                    original = oldTrampoline or origWrite, hooked = writeHook
                }
            end
        )
    end

    if type(appendfile) == "function" and type(hookfunction) == "function" then
        pcall(
            function()
                local origAppend = appendfile
                local origCloned = (type(clonefunction) == "function" and clonefunction(origAppend))
                local oldTrampoline
                local appendHook = registerProtectedClosure(
                    function(path, content, ...)
                        if Config.fileSandbox then
                            local ok, reason = checkPathSafe(path, content)
                            if not ok then
                                Stats.suspiciousFilesBlocked = Stats.suspiciousFilesBlocked + 1
                                recordThreat(
                                    "File-Sandbox",
                                    "Blocked appendfile: " .. tostring(path) .. " (" .. tostring(
                                        reason
                                    ) .. ")"
                                )
                                pushAlert("File Blocked", tostring(reason), 3)
                                updateStatsUI()
                                return false
                            end
                        end
                        if oldTrampoline then
                            return oldTrampoline(path, content, ...)
                        end
                        if origCloned and origCloned ~= origAppend then
                            return origCloned(path, content, ...)
                        end
                        return origAppend(path, content, ...)
                    end
                )
                oldTrampoline = hookfunction(appendfile, appendHook)
                hookedFunctions["appendfile"] = {
                    original = oldTrampoline or origAppend, hooked = appendHook
                }
            end
        )
    end
end
setupFileSystemProtection()

local function setupOverlayEraser()
    local function checkGui(inst)
        if not Config.overlayEraser or not inst or not inst:IsA("ScreenGui") then
            return
        end
        if inst.Name == "Rayfield" or inst.Name == "YudoProtectionGui" then
            return
        end

        pcall(
            function()
                if inst.DisplayOrder >= 9999 then
                    for _, child in ipairs(inst:GetDescendants()) do
                        if child:IsA("Frame") and child.Visible and child.BackgroundTransparency <= 0.05 then
                            local sz = child.Size
                            if sz.X.Scale >= 0.9 and sz.Y.Scale >= 0.9 then
                                Stats.overlaysErased = Stats.overlaysErased + 1
