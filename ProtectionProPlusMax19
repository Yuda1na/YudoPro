local function setupComfortGuards()
    local function monitorSound(sound)
        if not Config.earProtection or not sound or not sound:IsA("Sound") then
            return
        end
        pcall(
            function()
                if sound.Volume > 2.0 then
                    sound.Volume = 1.0
                end
                local c = sound:GetPropertyChangedSignal("Volume"):Connect(
                    function()
                        if Config.earProtection and sound.Volume > 2.0 then
                            sound.Volume = 1.0
                        end
                    end
                )
                table.insert(connections, c)
            end
        )
    end

    for _, s in ipairs(workspace:GetDescendants()) do
        if s:IsA("Sound") then
            monitorSound(s)
        end
    end
    local sc = workspace.DescendantAdded:Connect(monitorSound)
    table.insert(connections, sc)

    local function monitorEffect(effect)
        if not Config.antiFlashbang or not effect then
            return
        end
        pcall(
            function()
                if effect:IsA("BlurEffect") and effect.Size > 25 then
                    effect.Size = 10
                elseif effect:IsA("ColorCorrectionEffect") and (effect.Brightness < -0.7 or effect.Brightness > 0.7) then
                    effect.Brightness = 0
                end
            end
        )
    end

    for _, e in ipairs(Lighting:GetChildren()) do
        monitorEffect(e)
    end
    local lc = Lighting.ChildAdded:Connect(monitorEffect)
    table.insert(connections, lc)
end
setupComfortGuards()

local function executePanicRecovery()
    pcall(
        function()
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end
    )

    pcall(
        function()
            local myChar = LocalPlayer.Character
            local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            local cam = workspace.CurrentCamera
            if cam and hum then
                cam.CameraSubject = hum
                cam.CameraType = Enum.CameraType.Custom
                cam.FieldOfView = 70
            end
            if hum then
                hum.Sit = false
                hum.PlatformStand = false
                hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                if hum.WalkSpeed < 16 then
                    hum.WalkSpeed = 16
                end
                if hum.JumpPower < 50 then
                    hum.JumpPower = 50
                end
            end
        end
    )

    pcall(
        function()
            if PlayerGui then
                for _, gui in ipairs(PlayerGui:GetChildren()) do
                    if gui:IsA("ScreenGui") and gui.DisplayOrder >= 9999 and gui.Name ~= "Rayfield" then
