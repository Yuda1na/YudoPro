local function isYudoClosure(fn)
    if not fn then
        return false
    end
    for _, f in ipairs(protectedClosures) do
        if f == fn then
            return true
        end
    end
    for _, h in pairs(hookedFunctions) do
        if h.hooked == fn or h.original == fn then
            return true
        end
    end
    return false
end

local function registerProtectedClosure(fn)
    if type(fn) == "function" then
        table.insert(protectedClosures, fn)
    end
    return fn
end

local function recordThreat(tag, info)
    local t = os.date("%X")
    local line = string.format("[%s] [%s] %s", t, string.upper(tag), tostring(info))
    table.insert(ThreatLogs, 1, line)
    if #ThreatLogs > 150 then
        table.remove(ThreatLogs)
    end
    if logConsole and type(logConsole.Append) == "function" then
        pcall(
            function()
                logConsole:Append(line)
            end
        )
    end
end

