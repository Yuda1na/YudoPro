local function setupDebugProtection()
    if type(debug) ~= "table" or type(hookfunction) ~= "function" then
        return
    end
    local debugFuncs = {
        "getupvalue", "setupvalue", "getupvalues", "getconstants", "getlocal", "setlocal", "sethook"
    }

    for _, name in ipairs(debugFuncs) do
        local orig = debug[name]
        if type(orig) == "function" then
            local origCloned = (type(clonefunction) == "function" and clonefunction(orig))
            local oldTrampoline
            local dbgHook = registerProtectedClosure(
                function(target, ...)
                    if Config.closureArmor and target and isYudoClosure(target) then
                        Stats.debugAttacksBlocked = Stats.debugAttacksBlocked + 1
                        recordThreat(
                            "Closure-Armor",
                            "Blocked debug." .. name .. " access to internal closure"
                        )
                        updateStatsUI()
                        return nil
                    end
                    if oldTrampoline then
                        return oldTrampoline(target, ...)
                    end
                    if origCloned and origCloned ~= orig then
                        return origCloned(target, ...)
                    end
                    return orig(target, ...)
                end
            )
            oldTrampoline = hookfunction(orig, dbgHook)
            hookedFunctions["debug." .. name] = {original = oldTrampoline or orig, hooked = dbgHook}
        end
    end
end
setupDebugProtection()

